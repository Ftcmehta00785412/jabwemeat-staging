# Optional overrides. Defaults already point to the existing JabWeMeat staging project.
# Copy to .env.local only if you need a different, approved development project.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-browser-safe-publishable-key
# Never expose service_role, sb_secret, database passwords or signing secrets in VITE_* variables.

# Server-only Razorpay settings. Never prefix the secret with VITE_.
# Local API reads .env; hosted API uses Vercel environment variables.
# Rotate any credential previously shared in chat before deployment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_TEST_ENABLED=false
